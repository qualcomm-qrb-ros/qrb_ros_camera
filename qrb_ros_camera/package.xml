<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qrb_ros_camera</name>
  <version>3.0.0</version>
  <description>Qualcomm Robotics camera ROS 2 node; the camera backend is selected through plugin_discovery</description>
  <maintainer email="danwa@qti.qualcomm.com">Dan Wang</maintainer>
  <license>BSD-3-Clause-Clear</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp_components</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <depend>qrb_camera</depend>
  <depend>qrb_ros_transport_image_type</depend>
  <depend>yaml-cpp</depend>

  <!-- No dependency on a camera backend: they are plugins of qrb_camera, found at run time
       through plugin_discovery. The image installs the ones it needs (the qmmf and qcarcam
       backends of qrb_camera); each comes with its own vendor SDK. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
